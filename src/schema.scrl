// JSON Schema, only as much of it as a tool's `inputSchema` needs.
//
// These exist so a tool declares its arguments in one readable expression
// rather than in a hand-built object literal. A schema written out by hand is a
// schema that drifts from the code that reads the arguments.

import scarlet/array
import scarlet/json.{Boolean, Integer, Json, List, Object, Str}
import ./jsonx

/** An object schema: named properties, and which of them are required. */
pub fn object(properties Array((String, Json)), required Array(String)) Json {
	Object(
		[
			('type', Str('object')),
			('properties', Object(properties)),
			('required', jsonx.texts(required)),
			('additionalProperties', Boolean(False)),
		],
	)
}

/** An object schema taking no arguments at all. */
pub fn nothing() Json {
	object([], [])
}

pub fn text(description String) Json {
	Object([('type', Str('string')), ('description', Str(description))])
}

pub fn integer(description String) Json {
	Object([('type', Str('integer')), ('description', Str(description))])
}

pub fn boolean(description String) Json {
	Object([('type', Str('boolean')), ('description', Str(description))])
}

/** A string constrained to a fixed set of values. */
pub fn one_of(values Array(String), description String) Json {
	Object(
		[('type', Str('string')), ('enum', jsonx.texts(values)), ('description', Str(description))],
	)
}

pub fn list_of(items Json, description String) Json {
	Object([('type', Str('array')), ('items', items), ('description', Str(description))])
}

/** A list of strings, the shape most of Heddle's list arguments take. */
pub fn texts(description String) Json {
	list_of(Object([('type', Str('string'))]), description)
}

/** An integer with a floor and a ceiling, for the scope and priority scales. */
pub fn ranged(low Int, high Int, description String) Json {
	Object(
		[
			('type', Str('integer')),
			('minimum', Integer(low)),
			('maximum', Integer(high)),
			('description', Str(description)),
		],
	)
}
