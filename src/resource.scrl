// The resource-server half of MCP authorization (spec rev 2026-07-28).
//
// An MCP server doing auth is an OAuth 2.1 resource server: it publishes
// Protected Resource Metadata (RFC 9728) naming its authorization server,
// and answers tokenless requests with a 401 whose WWW-Authenticate header
// points at that metadata. This module builds both; the host mounts the
// metadata at /.well-known/oauth-protected-resource itself.

import scarlet/array
import scarlet/json.{Json, List, Object, Str}
import ./jsonx

/** RFC 9728 metadata: this resource, its authorization server, its scopes. */
pub fn metadata(resource String, auth_server String, scopes Array(String)) Json {
	Object([
		('resource', Str(resource)),
		('authorization_servers', List([Str(auth_server)])),
		('scopes_supported', jsonx.texts(scopes)),
		('bearer_methods_supported', List([Str('header')])),
	])
}

/**
 * The WWW-Authenticate value for a 401: where the metadata lives and, when
 * not empty, the scope the request needed (RFC 6750 §3).
 */
pub fn challenge(metadata_url String, scope String) String {
	base = 'Bearer resource_metadata="${metadata_url}"'
	match scope {
		'' -> base
		_ -> '${base}, scope="${scope}"'
	}
}
