// JSON, because Scarlet's stdlib has none and MCP is JSON-RPC all the way down.
//
// The parser works in bytes rather than scalars. That is not an optimisation:
// a JSON document arrives as an HTTP body, which is a `Binary`, and the only
// place a decoded string is needed is at the leaves. Walking bytes means the
// structure — braces, brackets, commas — is read without decoding anything, and
// a document that is not valid UTF-8 fails at the string it fails in rather
// than at the front door.
//
// Depth is bounded. A parser that recurses once per nesting level and is fed by
// a network is a stack overflow with a countdown on it, so MAX_DEPTH ends the
// nesting before the stack does.

import scarlet/array
import scarlet/binary
import scarlet/result
import scarlet/binary.{Dec, Hex}
import scarlet/float
import scarlet/int
import scarlet/string

/** A JSON value. Objects keep their entries in the order they were written. */
pub type Json {
	Null
	Boolean(value Bool)
	// Integers and fractions are separate so an integer survives the round trip
	// as an integer. JSON-RPC ids are compared for equality, and `1` coming
	// back as `1.0` is a reply the client cannot match to its request.
	Num(value Int)
	Real(value Float)
	Text(value String)
	List(items Array(Json))
	Object(entries Array((String, Json)))
}

pub type Error {
	// Input ended in the middle of a value.
	Truncated
	// A byte that cannot start or continue a value here.
	Unexpected(at Int)
	BadEscape(at Int)
	BadNumber(at Int)
	// A string's bytes are not valid UTF-8.
	BadUtf8(at Int)
	TooDeep(at Int)
	// A complete value, then more bytes that are not whitespace.
	Trailing(at Int)
}

pub fn show_error(e Error) String {
	match e {
		Truncated -> 'truncated json'
		Unexpected(at) -> 'unexpected byte at ${at}'
		BadEscape(at) -> 'bad escape at ${at}'
		BadNumber(at) -> 'bad number at ${at}'
		BadUtf8(at) -> 'string is not utf-8 at ${at}'
		TooDeep(at) -> 'nested deeper than ${MAX_DEPTH} at ${at}'
		Trailing(at) -> 'trailing bytes at ${at}'
	}
}

const MAX_DEPTH = 64

const B_TAB = 9
const B_LF = 10
const B_CR = 13
const B_SPACE = 32
const B_QUOTE = 34
const B_PLUS = 43
const B_COMMA = 44
const B_MINUS = 45
const B_DOT = 46
const B_ZERO = 48
const B_NINE = 57
const B_COLON = 58
const B_UPPER_E = 69
const B_LBRACKET = 91
const B_BACKSLASH = 92
const B_RBRACKET = 93
const B_LOWER_B = 98
const B_LOWER_E = 101
const B_LOWER_F = 102
const B_LOWER_N = 110
const B_LOWER_R = 114
const B_LOWER_T = 116
const B_LOWER_U = 117
const B_LBRACE = 123
const B_RBRACE = 125

const B_BACKSPACE = 8
const B_FORMFEED = 12
const B_SLASH = 47

// ---------------------------------------------------------------------------
// Parsing.
// ---------------------------------------------------------------------------

/** Parse a whole document. Trailing non-whitespace is an error, not a stop. */
pub fn parse(input Binary) Result(Json, Error) {
	match parse_value(input, skip_ws(input, 0), 0) {
		Ok((value, next)) -> {
			rest = skip_ws(input, next)
			if rest == binary.byte_size(input) {
				Ok(value)
			} else {
				Err(Trailing(rest))
			}
		}
		Err(e) -> Err(e)
	}
}

/** Parse from a String, for callers that already have one. */
pub fn parse_string(s String) Result(Json, Error) {
	parse(binary.from_string(s))
}

fn skip_ws(b Binary, i Int) Int {
	if i >= binary.byte_size(b) {
		i
	} else {
		c = binary.byte_at(b, i)
		if c == B_SPACE || c == B_TAB || c == B_LF || c == B_CR {
			skip_ws(b, i + 1)
		} else {
			i
		}
	}
}

// Every parse step returns the value it read and the offset just past it, so
// the caller decides what may follow rather than each step guessing.
fn parse_value(b Binary, i Int, depth Int) Result((Json, Int), Error) {
	if depth > MAX_DEPTH {
		Err(TooDeep(i))
	} else if i >= binary.byte_size(b) {
		Err(Truncated)
	} else {
		c = binary.byte_at(b, i)
		if c == B_LBRACE {
			parse_object(b, skip_ws(b, i + 1), depth + 1, [])
		} else if c == B_LBRACKET {
			parse_list(b, skip_ws(b, i + 1), depth + 1, [])
		} else if c == B_QUOTE {
			match scan_string(b, i + 1, <<>>) {
				Ok((s, next)) -> Ok((Text(s), next))
				Err(e) -> Err(e)
			}
		} else if c == B_MINUS || { c >= B_ZERO && c <= B_NINE } {
			parse_number(b, i)
		} else if literal_at(b, i, <<'true'>>) {
			Ok((Boolean(True), i + 4))
		} else if literal_at(b, i, <<'false'>>) {
			Ok((Boolean(False), i + 5))
		} else if literal_at(b, i, <<'null'>>) {
			Ok((Null, i + 4))
		} else {
			Err(Unexpected(i))
		}
	}
}

// `slice_bytes` returns a Result since stdlib 2026-08; every call here has
// bounds already checked (or wants the old empty-on-out-of-range semantics).
fn slice_or_empty(b Binary, at Int, n Int) Binary {
	result.unwrap(binary.slice_bytes(b, at, n), <<>>)
}

fn literal_at(b Binary, i Int, word Binary) Bool {
	n = binary.byte_size(word)
	if i + n > binary.byte_size(b) {
		False
	} else {
		slice_or_empty(b, i, n) == word
	}
}

// `acc` is built in reverse and flipped once at the end: prepending is the
// cheap end of an array, and appending in a loop is how a parser becomes
// quadratic on a large document.
fn parse_list(b Binary, i Int, depth Int, acc Array(Json)) Result((Json, Int), Error) {
	if i >= binary.byte_size(b) {
		Err(Truncated)
	} else if binary.byte_at(b, i) == B_RBRACKET && array.length(acc) == 0 {
		// Only the opening `[` may be closed straight away. Reaching here with
		// elements behind us means a comma promised another one, so `[1,]` is
		// the error it is in JSON rather than a one-element array.
		Ok((List([]), i + 1))
	} else {
		match parse_value(b, i, depth) {
			Ok((value, next)) -> {
				after = skip_ws(b, next)
				if after >= binary.byte_size(b) {
					Err(Truncated)
				} else {
					c = binary.byte_at(b, after)
					if c == B_COMMA {
						parse_list(b, skip_ws(b, after + 1), depth, [value, ..acc])
					} else if c == B_RBRACKET {
						Ok((List(array.reverse([value, ..acc])), after + 1))
					} else {
						Err(Unexpected(after))
					}
				}
			}
			Err(e) -> Err(e)
		}
	}
}

fn parse_object(
	b Binary,
	i Int,
	depth Int,
	acc Array((String, Json)),
) Result((Json, Int), Error) {
	if i >= binary.byte_size(b) {
		Err(Truncated)
	} else if binary.byte_at(b, i) == B_RBRACE && array.length(acc) == 0 {
		Ok((Object([]), i + 1))
	} else if binary.byte_at(b, i) != B_QUOTE {
		Err(Unexpected(i))
	} else {
		match scan_string(b, i + 1, <<>>) {
			Ok((key, next)) -> {
				colon = skip_ws(b, next)
				if colon >= binary.byte_size(b) {
					Err(Truncated)
				} else if binary.byte_at(b, colon) != B_COLON {
					Err(Unexpected(colon))
				} else {
					match parse_value(b, skip_ws(b, colon + 1), depth) {
						Ok((value, done)) -> {
							after = skip_ws(b, done)
							if after >= binary.byte_size(b) {
								Err(Truncated)
							} else {
								c = binary.byte_at(b, after)
								if c == B_COMMA {
									parse_object(
										b,
										skip_ws(b, after + 1),
										depth,
										[(key, value), ..acc],
									)
								} else if c == B_RBRACE {
									Ok((Object(array.reverse([(key, value), ..acc])), after + 1))
								} else {
									Err(Unexpected(after))
								}
							}
						}
						Err(e) -> Err(e)
					}
				}
			}
			Err(e) -> Err(e)
		}
	}
}

// ---------------------------------------------------------------------------
// Strings.
// ---------------------------------------------------------------------------

// Ordinary bytes are copied a run at a time rather than one at a time: a string
// with no escapes in it is one slice and one append, which is the common case.
fn scan_string(b Binary, i Int, acc Binary) Result((String, Int), Error) {
	stop = scan_plain(b, i)
	kept = if stop == i {
		acc
	} else {
		binary.append(acc, slice_or_empty(b, i, stop - i))
	}
	if stop >= binary.byte_size(b) {
		Err(Truncated)
	} else if binary.byte_at(b, stop) == B_QUOTE {
		match binary.to_string(kept) {
			Ok(s) -> Ok((s, stop + 1))
			Err(Nil) -> Err(BadUtf8(stop))
		}
	} else {
		parse_escape(b, stop + 1, kept)
	}
}

fn scan_plain(b Binary, i Int) Int {
	if i >= binary.byte_size(b) {
		i
	} else {
		c = binary.byte_at(b, i)
		if c == B_QUOTE || c == B_BACKSLASH {
			i
		} else {
			scan_plain(b, i + 1)
		}
	}
}

fn parse_escape(b Binary, i Int, acc Binary) Result((String, Int), Error) {
	if i >= binary.byte_size(b) {
		Err(Truncated)
	} else {
		c = binary.byte_at(b, i)
		if c == B_LOWER_U {
			parse_unicode_escape(b, i + 1, acc)
		} else {
			match simple_escape(c) {
				Some(byte) -> scan_string(b, i + 1, binary.append(acc, <<byte:8>>))
				None -> Err(BadEscape(i))
			}
		}
	}
}

fn simple_escape(c Int) Option(Int) {
	if c == B_QUOTE {
		Some(B_QUOTE)
	} else if c == B_BACKSLASH {
		Some(B_BACKSLASH)
	} else if c == B_SLASH {
		Some(B_SLASH)
	} else if c == B_LOWER_B {
		Some(B_BACKSPACE)
	} else if c == B_LOWER_F {
		Some(B_FORMFEED)
	} else if c == B_LOWER_N {
		Some(B_LF)
	} else if c == B_LOWER_R {
		Some(B_CR)
	} else if c == B_LOWER_T {
		Some(B_TAB)
	} else {
		None
	}
}

const SURROGATE_HIGH_LO = 55296
const SURROGATE_HIGH_HI = 56319
const SURROGATE_LOW_LO = 56320
const SURROGATE_LOW_HI = 57343
const SURROGATE_BASE = 65536

// \uXXXX, and the surrogate pair that a character above the BMP arrives as. An
// unpaired surrogate is refused rather than encoded: it is not a scalar value,
// so there is no UTF-8 for it and writing one would produce a String the rest
// of the program could not trust.
fn parse_unicode_escape(b Binary, i Int, acc Binary) Result((String, Int), Error) {
	match hex4(b, i) {
		None -> Err(BadEscape(i))
		Some(cp) -> if cp >= SURROGATE_HIGH_LO && cp <= SURROGATE_HIGH_HI {
			if pair_follows(b, i + 4) {
				match hex4(b, i + 6) {
					None -> Err(BadEscape(i + 6))
					Some(low) -> if low >= SURROGATE_LOW_LO && low <= SURROGATE_LOW_HI {
						full = SURROGATE_BASE + { { cp - SURROGATE_HIGH_LO } * 1024 } +
						{ low - SURROGATE_LOW_LO }
						scan_string(b, i + 10, binary.append(acc, utf8(full)))
					} else {
						Err(BadEscape(i + 6))
					}
				}
			} else {
				Err(BadEscape(i))
			}
		} else if cp >= SURROGATE_LOW_LO && cp <= SURROGATE_LOW_HI {
			Err(BadEscape(i))
		} else {
			scan_string(b, i + 4, binary.append(acc, utf8(cp)))
		}
	}
}

fn pair_follows(b Binary, i Int) Bool {
	if i + 2 > binary.byte_size(b) {
		False
	} else {
		binary.byte_at(b, i) == B_BACKSLASH && binary.byte_at(b, i + 1) == B_LOWER_U
	}
}

fn hex4(b Binary, i Int) Option(Int) {
	if i + 4 > binary.byte_size(b) {
		None
	} else {
		match binary.parse_int(slice_or_empty(b, i, 4), Hex) {
			Ok(n) -> Some(n)
			Err(Nil) -> None
		}
	}
}

/** UTF-8 for one scalar value. */
fn utf8(cp Int) Binary {
	if cp < 128 {
		<<cp:8>>
	} else if cp < 2048 {
		b0 = 192 + { cp / 64 }
		b1 = 128 + { cp % 64 }
		<<b0:8, b1:8>>
	} else if cp < 65536 {
		b0 = 224 + { cp / 4096 }
		b1 = 128 + { { cp / 64 } % 64 }
		b2 = 128 + { cp % 64 }
		<<b0:8, b1:8, b2:8>>
	} else {
		b0 = 240 + { cp / 262144 }
		b1 = 128 + { { cp / 4096 } % 64 }
		b2 = 128 + { { cp / 64 } % 64 }
		b3 = 128 + { cp % 64 }
		<<b0:8, b1:8, b2:8, b3:8>>
	}
}

// ---------------------------------------------------------------------------
// Numbers.
// ---------------------------------------------------------------------------

// An integer stays an integer. A fraction or an exponent makes it a Real, built
// from its parts rather than handed to a float parser, because the stdlib has
// none: mantissa digits are exact in Int, and the scale is applied once.
fn parse_number(b Binary, start Int) Result((Json, Int), Error) {
	negative = binary.byte_at(b, start) == B_MINUS
	int_start = if negative {
		start + 1
	} else {
		start
	}
	int_end = scan_digits(b, int_start)
	if int_end == int_start {
		Err(BadNumber(start))
	} else {
		frac_start = if at_byte(b, int_end, B_DOT) {
			int_end + 1
		} else {
			int_end
		}
		frac_end = if frac_start == int_end {
			int_end
		} else {
			scan_digits(b, frac_start)
		}
		if frac_start != int_end && frac_end == frac_start {
			Err(BadNumber(frac_start))
		} else {
			match exponent(b, frac_end) {
				Err(e) -> Err(e)
				Ok((exp, next)) ->
					assemble(
						b,
						start,
						negative,
						int_start,
						int_end,
						frac_start,
						frac_end,
						exp,
						next,
					)
			}
		}
	}
}

fn assemble(
	b Binary,
	start Int,
	negative Bool,
	int_start Int,
	int_end Int,
	frac_start Int,
	frac_end Int,
	exp Int,
	next Int,
) Result((Json, Int), Error) {
	whole = digits_value(b, int_start, int_end)
	frac_len = if frac_start == int_end {
		0
	} else {
		frac_end - frac_start
	}
	match whole {
		None -> Err(BadNumber(start))
		Some(w) -> if frac_len == 0 && exp == 0 {
			Ok(
				(
					Num(if negative {
						-w
					} else {
						w
					}),
					next,
				),
			)
		} else {
			match fraction_value(b, frac_start, frac_end, frac_len) {
				None -> Err(BadNumber(frac_start))
				Some(f) -> {
					magnitude = { float.from_int(w) + f } * pow10(exp)
					Ok(
						(
							Real(if negative {
								-magnitude
							} else {
								magnitude
							}),
							next,
						),
					)
				}
			}
		}
	}
}

fn fraction_value(b Binary, frac_start Int, frac_end Int, frac_len Int) Option(Float) {
	if frac_len == 0 {
		Some(0.0)
	} else {
		match digits_value(b, frac_start, frac_end) {
			None -> None
			Some(digits) -> Some(float.from_int(digits) / pow10(frac_len))
		}
	}
}

fn digits_value(b Binary, from Int, to Int) Option(Int) {
	match binary.parse_int(slice_or_empty(b, from, to - from), Dec) {
		Ok(n) -> Some(n)
		Err(Nil) -> None
	}
}

fn exponent(b Binary, i Int) Result((Int, Int), Error) {
	if !{ at_byte(b, i, B_LOWER_E) || at_byte(b, i, B_UPPER_E) } {
		Ok((0, i))
	} else {
		signed = at_byte(b, i + 1, B_MINUS)
		digits_start = if signed || at_byte(b, i + 1, B_PLUS) {
			i + 2
		} else {
			i + 1
		}
		digits_end = scan_digits(b, digits_start)
		if digits_end == digits_start {
			Err(BadNumber(i))
		} else {
			match digits_value(b, digits_start, digits_end) {
				None -> Err(BadNumber(i))
				Some(n) -> Ok(
					(
						if signed {
							-n
						} else {
							n
						},
						digits_end,
					),
				)
			}
		}
	}
}

fn at_byte(b Binary, i Int, want Int) Bool {
	i < binary.byte_size(b) && binary.byte_at(b, i) == want
}

fn scan_digits(b Binary, i Int) Int {
	if i >= binary.byte_size(b) {
		i
	} else {
		c = binary.byte_at(b, i)
		if c >= B_ZERO && c <= B_NINE {
			scan_digits(b, i + 1)
		} else {
			i
		}
	}
}

fn pow10(n Int) Float {
	if n == 0 {
		1.0
	} else if n < 0 {
		1.0 / pow10(-n)
	} else {
		10.0 * pow10(n - 1)
	}
}

// ---------------------------------------------------------------------------
// Encoding.
// ---------------------------------------------------------------------------

/** Render a value. The output is compact — no spaces, no newlines. */
pub fn encode(j Json) String {
	binary.to_string(write(j)) or ''
}

pub fn encode_binary(j Json) Binary {
	write(j)
}

fn write(j Json) Binary {
	match j {
		Null -> <<'null'>>
		Boolean(True) -> <<'true'>>
		Boolean(False) -> <<'false'>>
		Num(n) -> binary.from_string(int.to_string(n))
		Real(f) -> binary.from_string(float.to_string(f))
		Text(s) -> quote(s)
		List(items) ->
			binary.append(binary.append(<<'['>>, joined(array.map(items, write), <<','>>)), <<']'>>)
		Object(entries) ->
			binary.append(
				binary.append(<<'{'>>, joined(array.map(entries, write_entry), <<','>>)),
				<<'}'>>,
			)
	}
}

fn write_entry(entry (String, Json)) Binary {
	(key, value) = entry
	binary.append(binary.append(quote(key), <<':'>>), write(value))
}

fn joined(parts Array(Binary), sep Binary) Binary {
	match parts {
		[] -> <<>>
		[h, ..t] -> array.fold(t, h, fn(acc, p) binary.append(binary.append(acc, sep), p))
	}
}

// A string is escaped by copying the runs that need nothing and emitting the
// bytes that do. Only what JSON requires is escaped: the quote, the backslash,
// and the control characters. Everything else, UTF-8 included, goes out as it
// came in.
fn quote(s String) Binary {
	body = binary.from_string(s)
	binary.append(binary.append(<<'"'>>, escape(body, 0, 0, <<>>)), <<'"'>>)
}

fn escape(b Binary, run_start Int, i Int, acc Binary) Binary {
	if i >= binary.byte_size(b) {
		flush(b, run_start, i, acc)
	} else {
		c = binary.byte_at(b, i)
		match escaped(c) {
			None -> escape(b, run_start, i + 1, acc)
			Some(replacement) ->
				escape(b, i + 1, i + 1, binary.append(flush(b, run_start, i, acc), replacement))
		}
	}
}

fn flush(b Binary, from Int, to Int, acc Binary) Binary {
	if to == from {
		acc
	} else {
		binary.append(acc, slice_or_empty(b, from, to - from))
	}
}

const B_LOWER_ZERO_PAIR = <<'\\u00'>>

fn escaped(c Int) Option(Binary) {
	if c == B_QUOTE {
		Some(<<'\\"'>>)
	} else if c == B_BACKSLASH {
		Some(<<'\\\\'>>)
	} else if c == B_LF {
		Some(<<'\\n'>>)
	} else if c == B_CR {
		Some(<<'\\r'>>)
	} else if c == B_TAB {
		Some(<<'\\t'>>)
	} else if c == B_BACKSPACE {
		Some(<<'\\b'>>)
	} else if c == B_FORMFEED {
		Some(<<'\\f'>>)
	} else if c < 32 {
		Some(binary.append(B_LOWER_ZERO_PAIR, hex2(c)))
	} else {
		None
	}
}

fn hex2(c Int) Binary {
	digits = binary.from_int_ascii(c, Hex)
	if binary.byte_size(digits) == 1 {
		binary.append(<<'0'>>, digits)
	} else {
		digits
	}
}

// ---------------------------------------------------------------------------
// Reading a parsed value.
// ---------------------------------------------------------------------------

/** The value at `key`, if this is an object that has one. */
pub fn get(j Json, key String) Option(Json) {
	match j {
		Object(entries) -> lookup(entries, key)
		_ -> None
	}
}

fn lookup(entries Array((String, Json)), key String) Option(Json) {
	match entries {
		[] -> None
		[(k, v), ..rest] -> if k == key {
			Some(v)
		} else {
			lookup(rest, key)
		}
	}
}

pub fn text_of(j Json) Option(String) {
	match j {
		Text(s) -> Some(s)
		_ -> None
	}
}

pub fn int_of(j Json) Option(Int) {
	match j {
		Num(n) -> Some(n)
		Real(f) -> Some(float.round(f))
		_ -> None
	}
}

pub fn bool_of(j Json) Option(Bool) {
	match j {
		Boolean(b) -> Some(b)
		_ -> None
	}
}

pub fn list_of(j Json) Option(Array(Json)) {
	match j {
		List(items) -> Some(items)
		_ -> None
	}
}

/** The string at `key`, or `fallback` if it is absent or not a string. */
pub fn text_at(j Json, key String, fallback String) String {
	match get(j, key) {
		Some(v) -> text_of(v) or fallback
		None -> fallback
	}
}

pub fn int_at(j Json, key String, fallback Int) Int {
	match get(j, key) {
		Some(v) -> int_of(v) or fallback
		None -> fallback
	}
}

pub fn bool_at(j Json, key String, fallback Bool) Bool {
	match get(j, key) {
		Some(v) -> bool_of(v) or fallback
		None -> fallback
	}
}

/** The array at `key`, empty if absent or not an array. */
pub fn list_at(j Json, key String) Array(Json) {
	match get(j, key) {
		Some(v) -> list_of(v) or []
		None -> []
	}
}

/** Every string in the array at `key`, dropping anything that is not one. */
pub fn texts_at(j Json, key String) Array(String) {
	array.fold(list_at(j, key), [], fn(acc, item) match text_of(item) {
		Some(s) -> [..acc, s]
		None -> acc
	})
}

pub fn is_null(j Json) Bool {
	match j {
		Null -> True
		_ -> False
	}
}

// ---------------------------------------------------------------------------
// Building.
// ---------------------------------------------------------------------------

/** An object from entries, dropping any whose value is `None`. */
pub fn object(entries Array((String, Option(Json)))) Json {
	Object(
		array.fold(entries, [], fn(acc, entry) {
			(key, value) = entry
			match value {
				Some(v) -> [..acc, (key, v)]
				None -> acc
			}
		}),
	)
}

/** An array of strings as a JSON array. */
pub fn texts(values Array(String)) Json {
	List(array.map(values, fn(s) Text(s)))
}
