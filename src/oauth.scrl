// A minimal OAuth 2.1 authorization server, shaped by what MCP's
// authorization spec (rev 2026-07-28) requires of one: metadata discovery
// (RFC 8414), an authorization-code flow with PKCE S256 only, public
// clients via dynamic registration (RFC 7591), opaque bearer tokens, and
// resource indicators carried through the grant.
//
// The library owns the protocol; the host owns everything with a lifetime.
// Storage arrives as a `Store` of closures over whatever the host persists
// with, and the consent page is the host's: this module parses an
// /authorize request and mints the redirect for an approved one, but never
// renders a form. What a "user" is — an invite code, a password, a
// hardware key — is deliberately not this module's business.

import scarlet/array
import scarlet/base64
import scarlet/binary
import scarlet/crypto
import scarlet/http.{Request}
import scarlet/http/body
import scarlet/json.{Json, List, Object, Str}
import scarlet/option
import scarlet/result
import scarlet/string
import ./jsonx

const MAX_FORM = 65536

/** Everything a grant carries from consent to token to bearer check. */
pub type Grant {
	Grant(
		user String,
		scope String,
		client_id String,
		redirect_uri String,
		challenge String,
		resource String,
	)
}

/** Host-provided persistence. Codes are one-shot: `take_code` must consume. */
pub type Store {
	Store(
		put_client fn(String, String) Nil,
		get_client fn(String) Option(String),
		put_code fn(String, Grant) Nil,
		take_code fn(String) Option(Grant),
		put_token fn(String, Grant) Nil,
		get_token fn(String) Option(Grant),
	)
}

// ---------- discovery ----------

/** RFC 8414 metadata for an AS living under `issuer` (no trailing slash). */
pub fn metadata(issuer String, scopes Array(String)) Json {
	Object([
		('issuer', Str(issuer)),
		('authorization_endpoint', Str('${issuer}/oauth/authorize')),
		('token_endpoint', Str('${issuer}/oauth/token')),
		('registration_endpoint', Str('${issuer}/oauth/register')),
		('response_types_supported', List([Str('code')])),
		('grant_types_supported', List([Str('authorization_code')])),
		('code_challenge_methods_supported', List([Str('S256')])),
		('token_endpoint_auth_methods_supported', List([Str('none')])),
		('scopes_supported', jsonx.texts(scopes)),
	])
}

// ---------- forms and queries ----------

fn hex_val(c Int) Int {
	if c >= 48 && c <= 57 {
		c - 48
	} else if c >= 97 && c <= 102 {
		c - 87
	} else if c >= 65 && c <= 70 {
		c - 55
	} else {
		0 - 1
	}
}

fn pct_decode(b Binary, at Int, acc Binary) Binary {
	size = binary.byte_size(b)
	if at >= size {
		acc
	} else {
		c = binary.byte_at(b, at)
		if c == 43 {
			// '+' is a space in form encoding.
			pct_decode(b, at + 1, binary.append(acc, <<32:8>>))
		} else if c == 37 && at + 2 < size {
			hi = hex_val(binary.byte_at(b, at + 1))
			lo = hex_val(binary.byte_at(b, at + 2))
			if hi < 0 || lo < 0 {
				pct_decode(b, at + 1, binary.append(acc, <<c:8>>))
			} else {
				pct_decode(b, at + 3, binary.append(acc, <<{ hi * 16 + lo }:8>>))
			}
		} else {
			pct_decode(b, at + 1, binary.append(acc, <<c:8>>))
		}
	}
}

/** `a=1&b=2` (query string or form body) as pairs, percent-decoded. */
pub fn form_decode(b Binary) Array((String, String)) {
	text = binary.to_string(b) or ''
	array.fold(string.split(text, '&'), [], fn(acc, pair) {
		match string.split(pair, '=') {
			[k, v] -> {
				key = binary.to_string(pct_decode(binary.from_string(k), 0, <<>>)) or ''
				value = binary.to_string(pct_decode(binary.from_string(v), 0, <<>>)) or ''
				[..acc, (key, value)]
			}
			_ -> acc
		}
	})
}

pub fn form_get(pairs Array((String, String)), key String) Option(String) {
	option.map(
		array.find(pairs, fn(p) {
			(k, _) = p
			k == key
		}),
		fn(p) {
			(_, v) = p
			v
		},
	)
}

/** Percent-encode for a redirect query: everything but the unreserved set. */
pub fn pct_encode(s String) String {
	b = binary.from_string(s)
	binary.to_string(pct_encode_from(b, 0, <<>>)) or ''
}

fn pct_encode_from(b Binary, at Int, acc Binary) Binary {
	if at >= binary.byte_size(b) {
		acc
	} else {
		c = binary.byte_at(b, at)
		unreserved = { c >= 48 && c <= 57 } || { c >= 65 && c <= 90 } || { c >= 97 && c <= 122 } ||
			c == 45 || c == 46 || c == 95 || c == 126
		next = if unreserved {
			binary.append(acc, <<c:8>>)
		} else {
			hi = c / 16
			lo = c % 16
			binary.append(acc, <<37:8, hex_digit(hi):8, hex_digit(lo):8>>)
		}
		pct_encode_from(b, at + 1, next)
	}
}

fn hex_digit(n Int) Int {
	if n < 10 {
		48 + n
	} else {
		55 + n
	}
}

// ---------- registration (RFC 7591, public clients) ----------

/**
 * Register a public client: remember its redirect uris, hand back an id.
 * No secret is issued — these are PKCE public clients (auth method `none`).
 */
pub fn register(store Store, req_body Binary) Result(Json, String) {
	doc <- result.then(result.map_err(json.parse_binary(req_body), fn(_) 'body is not json'))
	j = json.to_json(doc)
	uris = jsonx.list_of(jsonx.get(j, 'redirect_uris') or json.Null) or []
	uri_texts = array.fold(uris, [], fn(acc, u) {
		match jsonx.text_of(u) {
			Some(t) -> [..acc, t]
			None -> acc
		}
	})
	match uri_texts {
		[] -> Err('redirect_uris is required')
		_ -> {
			id = new_token()
			Store(put_client, _, _, _, _, _) = store
			put_client(id, join_uris(uri_texts))
			Ok(Object([
				('client_id', Str(id)),
				('redirect_uris', jsonx.texts(uri_texts)),
				('token_endpoint_auth_method', Str('none')),
				('grant_types', List([Str('authorization_code')])),
				('response_types', List([Str('code')])),
			]))
		}
	}
}

fn join_uris(uris Array(String)) String {
	array.fold(uris, '', fn(acc, u) {
		match acc {
			'' -> u
			_ -> '${acc} ${u}'
		}
	})
}

// ---------- authorize ----------

/** A parsed, validated /authorize request, ready for the host's consent UI. */
pub type AuthorizeReq {
	AuthorizeReq(
		client_id String,
		redirect_uri String,
		state String,
		challenge String,
		scope String,
		resource String,
	)
}

/**
 * Read and validate the query of `GET /authorize`. The redirect uri must be
 * one the client registered: a code delivered to an unregistered uri is a
 * stolen code.
 */
pub fn parse_authorize(store Store, req Request) Result(AuthorizeReq, String) {
	q = form_decode(http.query(req))
	client_id = form_get(q, 'client_id') or ''
	redirect_uri = form_get(q, 'redirect_uri') or ''
	challenge = form_get(q, 'code_challenge') or ''
	method = form_get(q, 'code_challenge_method') or ''
	Store(_, get_client, _, _, _, _) = store
	registered = get_client(client_id) or ''
	if client_id == '' || redirect_uri == '' {
		Err('client_id and redirect_uri are required')
	} else if !array.contains(string.split(registered, ' '), redirect_uri) {
		Err('redirect_uri is not registered for this client')
	} else if { form_get(q, 'response_type') or '' } != 'code' {
		Err('only response_type=code is supported')
	} else if method != 'S256' || challenge == '' {
		Err('PKCE S256 is required')
	} else {
		Ok(AuthorizeReq(
			client_id: client_id,
			redirect_uri: redirect_uri,
			state: form_get(q, 'state') or '',
			challenge: challenge,
			scope: form_get(q, 'scope') or '',
			resource: form_get(q, 'resource') or '',
		))
	}
}

/**
 * The host approved: mint a one-shot code bound to `user` and hand back the
 * redirect target.
 */
pub fn approve(store Store, areq AuthorizeReq, user String) String {
	AuthorizeReq(client_id, redirect_uri, state, challenge, scope, resource) = areq
	code = new_token()
	Store(_, _, put_code, _, _, _) = store
	put_code(code, Grant(
		user: user,
		scope: scope,
		client_id: client_id,
		redirect_uri: redirect_uri,
		challenge: challenge,
		resource: resource,
	))
	sep = match string.contains(redirect_uri, '?') {
		True -> '&'
		False -> '?'
	}
	'${redirect_uri}${sep}code=${pct_encode(code)}&state=${pct_encode(state)}'
}

// ---------- token ----------

/**
 * `POST /token`: exchange a code for a bearer token. PKCE is the client
 * authentication — the verifier must hash to the challenge the code was
 * minted under, compared in constant time.
 */
pub fn token(store Store, req_body Binary) Result(Json, String) {
	form = form_decode(req_body)
	code = form_get(form, 'code') or ''
	verifier = form_get(form, 'code_verifier') or ''
	if { form_get(form, 'grant_type') or '' } != 'authorization_code' {
		Err('only grant_type=authorization_code is supported')
	} else if code == '' || verifier == '' {
		Err('code and code_verifier are required')
	} else {
		Store(_, _, _, take_code, put_token, _) = store
		match take_code(code) {
			None -> Err('code is unknown, used, or expired')
			Some(g) -> {
				Grant(_, scope, client_id, redirect_uri, challenge, _) = g
				hashed = base64.url_encode(crypto.sha256(binary.from_string(verifier)))
				ok_client = { form_get(form, 'client_id') or client_id } == client_id
				ok_redirect = { form_get(form, 'redirect_uri') or redirect_uri } == redirect_uri
				if !crypto.const_eq(hashed, binary.from_string(challenge)) {
					Err('PKCE verification failed')
				} else if !ok_client || !ok_redirect {
					Err('client_id or redirect_uri does not match the grant')
				} else {
					tok = new_token()
					put_token(tok, g)
					Ok(Object([
						('access_token', Str(tok)),
						('token_type', Str('Bearer')),
						('scope', Str(scope)),
					]))
				}
			}
		}
	}
}

/** The bearer check for the resource side: token text to its grant. */
pub fn bearer(store Store, token_text String) Option(Grant) {
	Store(_, _, _, _, _, get_token) = store
	get_token(token_text)
}

// 32 random bytes, url-safe: token, code, and client-id material alike.
fn new_token() String {
	bytes = crypto.random_bytes(32) or <<>>
	binary.to_string(base64.url_encode(bytes)) or ''
}
